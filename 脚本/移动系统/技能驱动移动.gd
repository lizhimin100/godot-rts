extends 移动策略
class_name 技能驱动移动

## 技能驱动策略 — 建造、嘲讽、冲锋等技能引发的位移
##
## ⚠ 建造移动不走流场（施工场地碰撞体会阻挡流场），直接指向目标
##
## 使用方式：
##   技能系统构造 移动请求(skill_driven, 目标位置, 来源=self, 数据={"建筑类型": ...})
##   单位收到后自动使用此策略移动到目标位置
##
## 到达后：运动服务发送"移动结束"信号，
## 技能系统监听该信号后执行实际技能效果（如开始建造）

var _停止距离平方: float = 0.0

func _初始化(请求: 移动请求) -> void:
	if _停止距离平方 == 0.0:
		_停止距离平方 = 请求.停止距离 * 请求.停止距离


func 计算速度(单位: Node2D, 请求: 移动请求) -> Vector2:
	_初始化(请求)

	# 不走流场，直接指向目标（施工场地本身的碰撞体会阻挡流场）
	var 最终目标 = 获取最终目标(请求, 单位)
	var 方向 = 最终目标 - 单位.global_position
	if 方向.length_squared() < 0.0001:
		return Vector2.ZERO
	return 方向.normalized() * 单位.移动速度


func 是否已到达(单位: Node2D, 请求: 移动请求) -> bool:
	_初始化(请求)
	var 最终目标 = 获取最终目标(请求, 单位)
	var 距离平方 = 单位.global_position.distance_squared_to(最终目标)
	return 距离平方 <= _停止距离平方
