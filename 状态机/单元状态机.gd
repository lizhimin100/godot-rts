class_name 单元状态机
extends Node

## 通用状态机 — RTS 单位唯一状态决策者
##
## 职责：
##   1. 读取 当前命令 → 决定下一状态
##   2. 状态入场时发起/停止移动请求
##   3. 监听 运动服务 的移动完成信号 → 状态切换
##   4. 每帧执行当前状态的持续逻辑
##
## 与运动服务的关系：
##   运动服务 = 速度驱动器（只管怎么走）
##   状态机   = 决策者   （管要不要走、走到哪、到了没）

enum 状态 {
	待机,    # 空闲，无命令
	移动,    # 走向目标位置（右键地面）
	追击,    # 追击敌人（右键敌人）
	攻击,    # 攻击中
	移动攻击, # A-move：走向目标，沿途遇敌自动攻击
	建造,    # 农民建造专用
}

## 状态名 → 动画名 映射（单位可在 _ready 中覆盖）
var 动画映射: Dictionary = {
	状态.待机: "待机",
	状态.移动: "移动",
	状态.追击: "移动",
	状态.攻击: "攻击",
	状态.移动攻击: "移动",
	状态.建造: "攻击",
}

## 当前状态（外部只读）
var 当前状态: int = -1 : set = _设状态

## 信号
signal 状态改变(旧状态: int, 新状态: int)
signal 到达目的地()       # 运动服务报告已到达
signal 追击目标丢失()     # 追击目标死亡/消失
signal 移动卡死()         # 卡死超时

var _单位: 单位基类 = null
var _已入场: bool = false  # 防止 _ready 的 setter 在 _unit 初始化前触发


# ============================================================
# 静态工厂
# ============================================================

static func 附加到(unit: 单位基类) -> 单元状态机:
	var sm = 单元状态机.new()
	sm.name = "状态机"
	sm.process_priority = -1  # 在单位之前运行，单位可覆盖动画
	unit.add_child(sm)
	return sm


# ============================================================
# 生命周期
# ============================================================

func _enter_tree():
	if not _单位:
		_单位 = get_parent() as 单位基类
	# 每次入树都连接信号（防止重新入树后信号丢失）
	if _单位 and is_instance_valid(运动服务.实例):
		if not 运动服务.实例.移动完成.is_connected(_on_移动完成):
			运动服务.实例.移动完成.connect(_on_移动完成)


func _ready():
	if not _单位:
		_单位 = get_parent() as 单位基类
		if not _单位:
			push_error("单元状态机必须挂在单位基类子节点")
			set_process(false)
			set_physics_process(false)
			return
	# 启动状态
	_已入场 = true
	当前状态 = 状态.待机


func _exit_tree():
	if is_instance_valid(运动服务.实例):
		if 运动服务.实例.移动完成.is_connected(_on_移动完成):
			运动服务.实例.移动完成.disconnect(_on_移动完成)


# ============================================================
# 每帧：决策 → 执行
# ============================================================

func _physics_process(_delta: float):
	if not _单位: return
	var 下一状态 = _决定下一状态()
	if 下一状态 != 当前状态:
		当前状态 = 下一状态
	_执行当前状态(_delta)


# ============================================================
# 对外接口
# ============================================================

## 立即响应命令变化（由 UnitBase.设置命令 在设置 type/pos/target 后调用）
func 立即响应() -> void:
	if not _单位: return
	var 下一状态 = _决定下一状态()
	if 下一状态 != 当前状态:
		当前状态 = 下一状态
	else:
		# 同状态命令覆盖：重新发出移动请求（目标位置可能变了）
		_重发移动请求(下一状态)


## 重新发出当前状态的移动请求（用于同状态命令覆盖）
func _重发移动请求(状态值: int) -> void:
	match 状态值:
		状态.移动:
			_单位.立即停止()  # 先打断旧移动
			_发出移动请求()
		状态.追击:
			_单位.立即停止()
			_发出追击请求()
		状态.移动攻击:
			_单位.立即停止()
			_发出移动攻击请求()


# ============================================================
# 状态决策 — 读当前命令 + 环境 → 输出下一状态
# ============================================================

func _决定下一状态() -> int:
	var cmd = _单位.当前命令

	match cmd:
		命令管理器.命令类型.无:
			return 状态.待机

		命令管理器.命令类型.移动, 命令管理器.命令类型.巡逻:
			return 状态.移动

		命令管理器.命令类型.攻击:
			return _决定攻击状态()

		命令管理器.命令类型.移动攻击:
			return 状态.移动攻击

		命令管理器.命令类型.停止, 命令管理器.命令类型.驻守:
			return 状态.待机

	return 状态.待机


func _决定攻击状态() -> int:
	var 目标 = _单位.攻击目标
	if not is_instance_valid(目标) or not _单位.是敌对(目标):
		return 状态.待机
	var 距离 = _单位.global_position.distance_to(目标.global_position)
	var 攻距 = _单位.战斗组件.attack_range if _单位.战斗组件 else 45.0
	if 距离 <= 攻距:
		return 状态.攻击
	return 状态.追击


# ============================================================
# 状态切换
# ============================================================

func _设状态(v: int):
	if not _已入场:
		当前状态 = v
		return
	if 当前状态 == v: return
	var 旧 = 当前状态
	当前状态 = v
	_入场动作(v)
	状态改变.emit(旧, v)


func _入场动作(状态值: int):
	# 切换动画
	var 动画 = 动画映射.get(状态值, "待机")
	if _单位.has_method("_切换动画"):
		_单位._切换动画(动画)

	match 状态值:
		状态.待机:
			_单位.立即停止()

		状态.移动:
			_发出移动请求()

		状态.追击:
			_发出追击请求()

		状态.移动攻击:
			_发出移动攻击请求()

		状态.攻击:
			_单位.立即停止()
			# 攻击由 CombatComponent 的 attack_started/strike/finished 驱动

		# 建造状态的移动由农民自己的命令建造逻辑处理


# ============================================================
# 状态执行（每帧持续逻辑）
# ============================================================

func _执行当前状态(_delta: float):
	match 当前状态:
		状态.待机:
			_执行待机()
		状态.追击:
			_执行追击()
		# 移动/移动攻击：由运动服务驱动速度，状态机无需额外操作
		# 攻击：由 CombatComponent 驱动
		# 建造：由农民自身逻辑驱动


## 待机 — 如果配置了空闲索敌，自动寻找敌人
func _执行待机():
	if _单位.当前命令 != 命令管理器.命令类型.无:
		return
	var 索敌 = _单位.索敌组件 if _单位.索敌组件 else null
	if not 索敌: return
	var 目标 = 索敌.get_target()
	if not is_instance_valid(目标): return
	if not _单位.是敌对(目标): return
	# 自动攻击
	_单位.攻击目标 = 目标
	_单位.当前命令 = 命令管理器.命令类型.攻击


## 追击 — 每帧更新目标位置（目标在移动）
func _执行追击():
	var 目标 = _单位.攻击目标
	if not is_instance_valid(目标):
		_单位.当前命令 = 命令管理器.命令类型.无
		return
	_单位.目标位置 = 目标.global_position
	# 进入攻击范围由 _决定攻击状态 处理（下一帧切到攻击）


# ============================================================
# 移动请求
# ============================================================

func _发出移动请求():
	if not _单位: return
	var 请求 = 移动请求.前往位置(_单位.目标位置)
	请求.停止距离 = _单位.停止阈值
	# 写入预存的队形偏移（由 CommandManager 在发出命令前设置）
	# ⭐ 用 slot_id >= 0 判断（不要用 offset != ZERO，offset 可能为 0）
	if _单位._pending_formation_slot >= 0:
		请求.队形偏移 = _单位._pending_formation_offset
		请求.队形槽位 = _单位._pending_formation_slot
		_单位._pending_formation_offset = Vector2.ZERO
		_单位._pending_formation_slot = -1
	_单位.应用移动请求(请求)


func _发出追击请求():
	if not _单位: return
	var 目标 = _单位.攻击目标
	if not is_instance_valid(目标): return
	var 请求 = 移动请求.追击敌人(目标)
	_单位.应用移动请求(请求)


func _发出移动攻击请求():
	if not _单位: return
	var 请求 = 移动请求.移动攻击(_单位.目标位置)
	_单位.应用移动请求(请求)


# ============================================================
# 接收运动服务的移动完成信号
# ============================================================

func _on_移动完成(移动单位: Node2D, 结果: 移动结果):
	if 移动单位 != _单位: return
	match 结果.结果:
		移动结果.结果类型.已到达:
			_on_到达()
		移动结果.结果类型.目标丢失:
			_on_目标丢失()
		移动结果.结果类型.被中断:
			pass  # 新命令覆盖，保持当前状态即可
		移动结果.结果类型.卡死:
			_on_卡死()


func _on_到达():
	到达目的地.emit()
	match 当前状态:
		状态.移动, 状态.移动攻击:
			# 到达目的地后没新命令 → 转待机
			if _单位.当前命令 in [命令管理器.命令类型.移动, 命令管理器.命令类型.无]:
				_单位.当前命令 = 命令管理器.命令类型.无
		状态.追击:
				# 追击的"到达"意味着进入攻击范围（strategy 用 attack_range 做停止距离）
				pass


func _on_目标丢失():
	追击目标丢失.emit()
	_单位.当前命令 = 命令管理器.命令类型.无


func _on_卡死():
	移动卡死.emit()
	# 卡死时不丢失命令，运动服务会自动回退重试
	# 等待用户发新命令覆盖（新命令 → _决定下一状态 → 重新请求移动 → 重置卡死状态）
