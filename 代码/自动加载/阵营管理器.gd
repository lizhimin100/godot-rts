extends Node

## 阵营管理器 — 全局阵营关系表
## Autoload，管理所有阵营之间的友军/中立/敌对关系

enum 阵营 {
	玩家,   # 玩家自己
	盟友,   # 盟友（不攻击）
	敌人,   # 敌人
	中立,   # 中立（不主动攻击，但可被攻击）
}

enum 关系 {
	友军,   # 不攻击、不造成碰撞伤害
	中立,   # 不主动攻击，但可被选中攻击
	敌对,   # 自动攻击
}

## 阵营关系表 [阵营A][阵营B] → 关系
var _关系表: Dictionary = {
	阵营.玩家: { 阵营.玩家: 关系.友军, 阵营.盟友: 关系.友军, 阵营.敌人: 关系.敌对, 阵营.中立: 关系.中立 },
	阵营.盟友: { 阵营.玩家: 关系.友军, 阵营.盟友: 关系.友军, 阵营.敌人: 关系.敌对, 阵营.中立: 关系.中立 },
	阵营.敌人: { 阵营.玩家: 关系.敌对, 阵营.盟友: 关系.敌对, 阵营.敌人: 关系.友军, 阵营.中立: 关系.敌对 },
	阵营.中立: { 阵营.玩家: 关系.中立, 阵营.盟友: 关系.中立, 阵营.敌人: 关系.中立, 阵营.中立: 关系.友军 },
}


func 获取关系(a: 阵营, b: 阵营) -> int:
	return _关系表.get(a, {}).get(b, 关系.中立)


func 是敌对(a: 阵营, b: 阵营) -> bool:
	return 获取关系(a, b) == 关系.敌对


func 是友军(a: 阵营, b: 阵营) -> bool:
	return 获取关系(a, b) == 关系.友军
